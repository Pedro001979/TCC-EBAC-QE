{
  "name": "ebac-shop-mobile-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Android catalog automation for the EBAC Shop TCC",
  "scripts": {
    "test": "wdio run ./wdio.conf.cjs",
    "test:catalog": "wdio run ./wdio.conf.cjs --spec ./test/specs/catalog.spec.js",
    "report": "allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "allure open ./allure-report",
    "appium:driver": "appium driver install uiautomator2",
    "appium:start": "appium --base-path /"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.34.1",
    "appium": "^3.0.2",
    "appium-uiautomator2-driver": "^8.7.0",
    "dotenv": "^16.6.1",
    "webdriverio": "^9.20.0"
  }
}
